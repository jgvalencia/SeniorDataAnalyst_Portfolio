-- Query 10: View employee demographics data
select * from employee_demographics;
-- Query 11: View employee salary data
select * from employee_salary;
-- Query 12: View parks departments data
select * from parks_departments;

-- Query 13: Select all genders from employee demographics
select gender
from employee_demographics;

-- Query 14: Select distinct first names and genders
select distinct first_name, gender
from employee_demographics;

-- Where Clause

-- Query 15: Filter employee salaries by first name
select *
from employee_salary
where First_name = 'Leslie';

-- Query 16: Filter employee salaries above 50,000
select *
from employee_salary
where salary >= 50000;

-- Query 17: Filter employee demographics by gender
SELECT *
FROM employee_demographics
WHERE gender = 'Female';

-- Query 18: Filter employee demographics where gender is not female
#We can also return rows that do have not "Scranton"
SELECT *
FROM employee_demographics
WHERE gender != 'Female';

-- Query 19: Filter employee demographics by birth date
#We can use WHERE clause with date value also
SELECT *
FROM employee_demographics
WHERE birth_date > '1985-01-01';

-- Query 20: Filter employee demographics by birth date or gender
SELECT *
FROM employee_demographics
WHERE birth_date > '1985-01-01' or gender = 'male';

-- Group by

-- Query 21: Group employee demographics by gender and calculate average age
select gender, avg(age)
from employee_demographics
group by gender;

-- Query 22: Group employee salary records by occupation
select occupation
from employee_salary
GROUP BY occupation;

-- Query 23: Group employee salary records by occupation and salary
SELECT occupation, salary
FROM employee_salary
GROUP BY occupation, salary;

-- Query 24: Group employee demographics by gender with aggregate statistics
select gender, avg(age), max(age), min(age)
from employee_demographics
group by gender;

-- Query 25: Group employee demographics by gender with count
select gender, avg(age), max(age), min(age), count(age)
from employee_demographics
group by gender;

-- Query 26: Group employee demographics by gender with HAVING clause
select gender, avg(age)
from employee_demographics
group by gender
having avg(age) > 40;

-- Query 27: Group salary records by occupation with HAVING filter
select occupation, avg(salary)
from employee_salary
where occupation like '%manager%'
group by occupation
having avg(salary) > 75000;

-- Query 28: Limit employee demographics results to three rows
select *
from employee_demographics
Limit 3;

-- Query 29: Order employee demographics by age descending and limit results
select *
from employee_demographics
order by age desc
Limit 3;

-- Query 30: Order employee demographics by age descending and offset results
select *
from employee_demographics
order by age desc
Limit 2, 1;
