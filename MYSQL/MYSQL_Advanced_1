-- Delete Duplicated method 1

DELETE FROM ui_duplicatecolumn
WHERE employee_id IN (
    SELECT employee_id FROM (
        SELECT employee_id,
               ROW_NUMBER() OVER (PARTITION BY full_name ORDER BY employee_id) AS rn
        FROM ui_duplicatecolumn
    ) x
    WHERE rn > 1
);

-- Delete remove records from a Table

TRUNCATE TABLE ui_duplicatecolumn;

-- Delete Duplicated method 2 MYSQL Doesn't allow delete from CTE file, here is a workaround to do the delete in MYSQL

WITH cte AS (
    SELECT 
        employee_id,
        ROW_NUMBER() OVER (
            PARTITION BY full_name
            ORDER BY employee_id
        ) AS rn
    FROM ui_duplicatecolumn
)
DELETE a
FROM ui_duplicatecolumn as a
JOIN cte ON a.employee_id = cte.employee_id
WHERE cte.rn > 1;

-- common records from 2 tables with Intersect doen't work in MYSQL here a workaround

SELECT a.*
FROM ui_duplicatecolumn a
INNER JOIN ui_duplicatecolumn b
    ON a.employee_id = b.employee_id;
    
