-- find duplicate

SELECT full_name, COUNT(*) AS cnt
FROM ui_duplicatecolumn
GROUP BY full_name
HAVING COUNT(*) > 1;

-- check duplicate column table

select * from ui_duplicatecolumn;

SELECT employee_id, x.rn FROM (
SELECT employee_id, full_name, ROW_NUMBER() OVER (PARTITION BY full_name ORDER BY employee_id) AS rn from ui_duplicatecolumn) x
