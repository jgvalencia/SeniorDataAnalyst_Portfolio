-- Youngest employee in the organisaction

-- I need to add a new column with the birth_date

ALTER TABLE ui_employeesalary
ADD COLUMN birth_date date NULL;

-- query update the birth_date with value assure every employee is 18 years old or older birth+day is created random

UPDATE ui_employeesalary
SET birth_date = DATE(
    FROM_DAYS(
        FLOOR(
            RAND() * (TO_DAYS('2008-12-31') - TO_DAYS('1970-01-01')) 
            + TO_DAYS('1970-01-01')
        )
    )
);

select *
from ui_employeesalary
order by birth_date desc
limit 1;

