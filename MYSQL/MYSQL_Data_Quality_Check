-- Query 20: View the orders table
select * from Temp_Order;
-- Query 21: View the customers table
select * from Temp_Customer;

-- Query 22: Check for missing IDs in the customer table compared to orders
select o.id 
from Temp_Order o
left join Temp_Customer c
on o.id = c.id
where c.id is null;

-- Query 23: Validate that the age column contains only numeric values
SELECT *
FROM Temp_Customer
WHERE age REGEXP '^[0-9]+$' = 0;

-- Query 24: Check for invalid accepted values in the status column
select *
from Temp_Customer
where status not in ('Grande', 'Madiano', 'Pequeno');

-- MYSQL Window Functions
-- Query 25: Convert the temporary customer table to a regular table for window functions
CREATE TABLE Temp_Copy AS
SELECT * FROM Temp_Customer;

-- Query 26: Use ROW_NUMBER to assign row numbers
SELECT 
    id,
    ROW_NUMBER() OVER (ORDER BY age) AS rn
FROM Temp_Copy;

-- Query 27: Use RANK to rank salaries by descending value
SELECT 
    id,
    salary,
    RANK() OVER (ORDER BY salary DESC) AS salary_rank
FROM Temp_Copy;

-- Query 28: Use aggregate window functions for overall salary metrics
SELECT 
    id,
    salary,
    AVG(salary) OVER () AS avg_salary,
    SUM(salary) OVER () AS total_salary
FROM Temp_Copy;

-- Query 29: Use partitioned window functions by order ID
SELECT 
    orderid,
    salary,
    AVG(salary) OVER (PARTITION BY orderid) AS dept_avg_salary
FROM Temp_Copy;

-- Query 30: Calculate running totals by ID
SELECT 
    id,
    salary,
    SUM(salary) OVER (ORDER BY id) AS running_total
FROM Temp_Copy;

-- Query 31: Calculate a moving average over the previous two rows and current row
SELECT 
    id,
    salary,
    AVG(salary) OVER (
        ORDER BY id
        ROWS BETWEEN 2 PRECEDING AND CURRENT ROW
    ) AS moving_avg
FROM Temp_Copy;
