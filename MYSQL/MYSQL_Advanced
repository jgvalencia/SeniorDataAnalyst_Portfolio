-- Query 11: Create a second stored procedure with multiple statements
DELIMITER $$
Create Procedure large_salaries2()
begin
	select *
	from employee_salary
	where salary >= 50000;
	select *
	from employee_salary
	where salary >= 10000;
end $$
DELIMITER ;

-- Query 12: Call the second stored procedure
call large_salaries2();

-- Query 13: Create a stored procedure with a parameter
DELIMITER $$
Create Procedure large_salaries3(P_employee_id int)
begin
	select first_name, Last_name, salary
	from employee_salary
	where employee_id = P_employee_id;
end $$
DELIMITER ;

-- Query 14: Call the parameterized stored procedure
call large_salaries3(1);

-- Query 15: Create a trigger after insert on employee_salary
DELIMITER $$
Create trigger employee_insert
	after insert on employee_salary
    for each row
begin
	insert into employee_demographics (employee_id, first_name, last_name)
    values (new.employee_id, new.first_name, new.last_name);
end $$
DELIMITER ;

