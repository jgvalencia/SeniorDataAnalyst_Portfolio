
-- Query 1: View all employee demographics records
SELECT *
FROM employee_demographics;

-- Query 2: View all employee salary records
SELECT *
FROM employee_salary;

-- Query 3: Inner join employee demographics with salary data
select *
from employee_demographics
inner join employee_salary
	on employee_id = employee_id;

-- Query 4: Inner join using fully qualified column names
select *
from employee_demographics
inner join employee_salary
	on employee_demographics.employee_id = employee_salary.employee_id;

-- Query 5: Inner join using table aliases
select *
from employee_demographics a
inner join employee_salary b
	on a.employee_id = b.employee_id;
    
-- Query 6: Select specific columns from an inner join
select a.employee_id, age, occupation
from employee_demographics a
inner join employee_salary b
	on a.employee_id = b.employee_id;
    
-- Query 7: Left join demographics with salary data
select *
from employee_demographics a
left join employee_salary b
	on a.employee_id = b.employee_id;
    
-- Query 8: Right join demographics with salary data
select *
from employee_demographics a
right join employee_salary b
	on a.employee_id = b.employee_id;
    
-- Query 9: Self-join employee salary data
select emp1.employee_id as emp_santa, emp1.first_name as first_name_santa, emp1.last_name as last_name_santa,
emp2.employee_id as emp_name, emp2.first_name as first_name_emp, emp2.last_name as last_name_emp
from employee_salary emp1
join employee_salary emp2
	on emp1.employee_id + 1 = emp2.employee_id;
    
-- Query 10: Join demographics, salary, and departments
select *
from employee_demographics a
inner join employee_salary b
	on a.employee_id = b.employee_id
inner join parks_departments pd
	on b.employee_id = pd.department_id;
    
-- Query 11: Combine first and last names with UNION
select first_name, last_name
from employee_demographics
union 
select first_name, last_name
from employee_salary;

-- Query 12: Filter employees older than 50
select first_name, last_name
from employee_demographics
where age > 50
;

-- Query 13: Label older employees
select first_name, last_name, 'old' as label
from employee_demographics
where age > 50
;

-- Query 14: Label high-paid employees
select first_name, last_name, 'High Paid Employee' as label
from employee_salary
where salary > 70000
;

-- Query 15: Combine labeled demographic and salary results with UNION
select first_name, last_name, 'Old Man' as label
from employee_demographics
where age > 40 and gender = 'Male'
union
select first_name, last_name, 'Old Lady' as label
from employee_demographics
where age > 40 and gender = 'Female'
union
select first_name, last_name, 'High Paid Employee' as label
from employee_salary
where salary > 70000
;

-- Query 16: Show string length example
select length('sky');

-- Query 17: Show length of first names
select first_name, length(first_name)
from employee_demographics
order by 2;

-- Query 18: Show upper and lower case functions
select upper('sky'), lower('SKY');

-- Query 19: Convert first names to uppercase
select first_name, upper(first_name)
from employee_demographics;

-- Query 20: Trim whitespace from a string
select trim('            sky                      ');
-- Query 21: Left trim whitespace from a string
select ltrim('            sky                      ');
-- Query 22: Right trim whitespace from a string
select rtrim('            sky                      ');

-- Query 23: Use string manipulation functions on names and birth dates
select first_name, left(first_name,4), right(first_name,4), substring(first_name,3,2), birth_date, substring(birth_date, 6,2) as birth_month
from employee_demographics;

-- Query 24: Replace characters in first names
select first_name, replace(first_name, 'a', 'z')
from employee_demographics;

-- Query 25: Find the position of a character in a string
select locate('x', 'Alexander');

-- Query 26: Find the position of a substring in first names
select first_name, locate('An', first_name)
from employee_demographics;

-- Query 27: Concatenate first and last names
select first_name, last_name, concat(first_name, ' ', last_name) as full_name
from employee_demographics;

-- Query 28: Create age brackets using CASE
select first_name, last_name, age,

case
	when age <= 30 then 'Young'
	when age between 31 and 50  then 'old'
    when age >= 50 then "on death's door"
end as 'Age_Bracket'

from employee_demographics;

-- Query 29: View all employee salary rows again
select *
from employee_salary;

-- Pay Increase and Bonus
-- < 50000 = 5%
-- > 50000 = 7%
-- Finance = 10% bonus

-- Query 30: Calculate adjusted salaries and bonuses with CASE
select first_name, last_name, salary,
case
	when salary < 50000 then  salary * 1.05
	when salary > 50000 then  salary * 1.07
end as New_salary,
case
	when dept_id = 6 then salary * 0.10
end as Bonus
from employee_salary;

-- Query 31: Select employee IDs from salary records in department 1
select employee_id
					from employee_salary
                        where dept_id = 1;
                        
-- Query 32: Use a subquery to find matching employee demographics
select *
from employee_demographics
where employee_id in (select employee_id
						from employee_salary
                        where dept_id = 1);
                        
-- Query 33: Group salaries by first name and salary
select first_name, salary, avg(salary)
from employee_salary
group by first_name, salary;

-- Query 34: Show average salary as a scalar subquery
select first_name, salary, 
(select avg(salary) from employee_salary)
from employee_salary;

-- Query 35: Aggregate employee age statistics by gender
select gender, avg(age), max(age), min(age), count(age)
from employee_demographics
group by gender;

-- Query 36: Create an inline aggregate table
select *
from
(select gender, avg(age) as Avg_age, max(age) as Max_age, min(age) as min_age, count(age) as count_age
from employee_demographics
group by gender) as agg_table;

-- Query 37: Aggregate the aggregated results again
select gender, avg(avg_age), avg(Max_age)
from
(select gender, avg(age) as Avg_age, max(age) as Max_age, min(age) as min_age, count(age) as count_age
from employee_demographics
group by gender) as agg_table
group by gender;

-- Query 38: Calculate averages from the aggregate subquery
select avg(avg_age), avg(Max_age)
from
(select gender, avg(age) as Avg_age, max(age) as Max_age, min(age) as min_age, count(age) as count_age
from employee_demographics
group by gender) as agg_table
;

-- Query 39: Calculate average salary by gender
select gender, avg(salary) as avg_salary
from employee_demographics dem
join employee_salary sal
	on dem.employee_id = sal.employee_id
group by gender;

-- Query 40: Calculate average salary with window function partitioning
select gender, avg(salary) over(partition by gender)
from employee_demographics dem
join employee_salary sal
	on dem.employee_id = sal.employee_id
;

-- Query 41: Calculate rolling salary totals by gender
select dem.first_name, dem.last_name, gender, salary, sum(salary) over(partition by gender order by dem.employee_id) as Rolling_Total
from employee_demographics dem
join employee_salary sal
	on dem.employee_id = sal.employee_id
;

-- Query 42: Show row numbers without partitioning
select dem.first_name, dem.last_name, gender, salary, row_number() over()
from employee_demographics dem
join employee_salary sal
	on dem.employee_id = sal.employee_id
;

-- Query 43: Show row numbers partitioned by gender
select dem.first_name, dem.last_name, gender, salary, row_number() over(partition by gender)
from employee_demographics dem
join employee_salary sal
	on dem.employee_id = sal.employee_id
;

-- Query 44: Show row numbers partitioned by gender and ordered by salary
select dem.first_name, dem.last_name, gender, salary, row_number() over(partition by gender order by salary desc) as Numero_Consecutivo
from employee_demographics dem
join employee_salary sal
	on dem.employee_id = sal.employee_id
;

-- Query 45: Compare row number, rank, and dense rank within gender partitions
select dem.first_name, dem.last_name, gender, salary, 
row_number() over(partition by gender order by salary desc) as Numero_Consecutivo,
rank() over(partition by gender order by salary desc) as rank_number
from employee_demographics dem
join employee_salary sal
	on dem.employee_id = sal.employee_id
;

-- Query 46: Compare row number, rank, and dense rank with detailed window functions
select dem.first_name, dem.last_name, gender, salary, 
row_number() over(partition by gender order by salary desc) as Numero_Consecutivo,
rank() over(partition by gender order by salary desc) as rank_number,
dense_rank() over(partition by gender order by salary desc) as dense_rank_number
from employee_demographics dem
join employee_salary sal
	on dem.employee_id = sal.employee_id
;






    


    



